# WORKSPACE.bazel - System dependencies

workspace(name = "quadcopter_sim")

new_local_repository(
    name = "opencv",
    path = "/usr",
    build_file_content = """
cc_library(
    name = "opencv",
    hdrs = glob([
        "include/opencv4/opencv2/**/*.hpp",
        "include/opencv4/opencv2/**/*.h",
    ]),
    includes = ["include/opencv4"],
    linkopts = [
        "-L/lib/x86_64-linux-gnu",
        "-lopencv_core",
        "-lopencv_imgproc",
        "-lopencv_highgui",
        "-lopencv_imgcodecs",
    ],
    visibility = ["//visibility:public"],
)
""",
)